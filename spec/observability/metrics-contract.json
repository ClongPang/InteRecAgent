{
  "schemaVersion": 1,
  "metrics": [
    { "name": "rec_agent.api.enqueue.duration", "kind": "histogram", "unit": "s", "labels": ["operation", "outcome"], "slo": [{ "quantile": 0.95, "lessThan": 0.3 }] },
    { "name": "rec_agent.api.projection.duration", "kind": "histogram", "unit": "s", "labels": ["outcome"], "slo": [{ "quantile": 0.95, "lessThan": 0.5 }] },
    { "name": "rec_agent.sse.lag.duration", "kind": "histogram", "unit": "s", "labels": ["event_type"], "slo": [{ "quantile": 0.95, "lessThan": 1 }] },
    { "name": "rec_agent.queue.wait.duration", "kind": "histogram", "unit": "s", "labels": ["attempt"], "slo": [{ "quantile": 0.95, "lessThan": 2 }] },
    { "name": "rec_agent.queue.depth", "kind": "observable_gauge", "unit": "{turn}", "labels": ["status"] },
    { "name": "rec_agent.turn.duration", "kind": "histogram", "unit": "s", "labels": ["status", "route"], "slo": [{ "route": "talk|refilter|rerank|clarify", "quantile": 0.95, "lessThan": 8 }, { "route": "research", "quantile": 0.95, "lessThan": 45 }, { "route": "research", "quantile": 0.99, "lessThan": 60 }] },
    { "name": "rec_agent.turn.terminal", "kind": "counter", "unit": "{turn}", "labels": ["status", "committed", "route"] },
    { "name": "rec_agent.sse.connections", "kind": "up_down_counter", "unit": "{connection}", "labels": [] },
    { "name": "rec_agent.provider.request.duration", "kind": "histogram", "unit": "s", "labels": ["provider"] },
    { "name": "rec_agent.provider.errors", "kind": "counter", "unit": "{error}", "labels": ["provider"] },
    { "name": "rec_agent.candidate_cache.lookups", "kind": "counter", "unit": "{lookup}", "labels": ["outcome"] },
    { "name": "rec_agent.feedback.events", "kind": "counter", "unit": "{event}", "labels": ["kind"] },
    { "name": "rec_agent.fence.rejected_writes", "kind": "counter", "unit": "{write}", "labels": ["operation"] },
    { "name": "rec_agent.claim_validation_failures", "kind": "counter", "unit": "{failure}", "labels": [] },
    { "name": "rec_agent.safety_blocks", "kind": "counter", "unit": "{block}", "labels": [] },
    { "name": "rec_agent.evidence_blocks", "kind": "counter", "unit": "{block}", "labels": [] },
    { "name": "rec_agent.outbox.published", "kind": "counter", "unit": "{message}", "labels": [] },
    { "name": "rec_agent.outbox.failures", "kind": "counter", "unit": "{failure}", "labels": [] },
    { "name": "rec_agent.outbox.dead_letters", "kind": "counter", "unit": "{message}", "labels": [] },
    { "name": "rec_agent.outbox.backlog", "kind": "observable_gauge", "unit": "{message}", "labels": ["state"] },
    { "name": "gen_ai.invoke_agent.duration", "kind": "histogram", "unit": "s", "labels": ["route"] },
    { "name": "gen_ai.invoke_agent.inference_calls", "kind": "histogram", "unit": "{call}", "labels": ["route"] },
    { "name": "gen_ai.invoke_agent.tool_calls", "kind": "histogram", "unit": "{call}", "labels": ["route", "fallback"] }
  ],
  "forbiddenLabels": ["turn_id", "conversation_id", "tenant_id", "owner_id", "query", "content", "prompt", "offer_ref"]
}
