{
  "schemaVersion": 1,
  "purpose": "Process-local OpenTelemetry instrument inventory.",
  "metrics": [
    { "name": "retail_price_agent.api.enqueue.duration", "kind": "histogram", "unit": "s", "labels": ["operation", "outcome"] },
    { "name": "retail_price_agent.api.projection.duration", "kind": "histogram", "unit": "s", "labels": ["outcome"] },
    { "name": "retail_price_agent.sse.lag.duration", "kind": "histogram", "unit": "s", "labels": ["event_type"] },
    { "name": "retail_price_agent.queue.wait.duration", "kind": "histogram", "unit": "s", "labels": ["attempt"] },
    { "name": "retail_price_agent.queue.depth", "kind": "observable_gauge", "unit": "{turn}", "labels": ["status"] },
    { "name": "retail_price_agent.turn.duration", "kind": "histogram", "unit": "s", "labels": ["status", "route"] },
    { "name": "retail_price_agent.turn.terminal", "kind": "counter", "unit": "{turn}", "labels": ["status", "committed", "route"] },
    { "name": "retail_price_agent.sse.connections", "kind": "up_down_counter", "unit": "{connection}", "labels": [] },
    { "name": "retail_price_agent.provider.request.duration", "kind": "histogram", "unit": "s", "labels": ["provider", "operation", "outcome"] },
    { "name": "retail_price_agent.provider.errors", "kind": "counter", "unit": "{error}", "labels": ["provider", "failure_code"] },
    { "name": "retail_price_agent.candidate_cache.lookups", "kind": "counter", "unit": "{lookup}", "labels": ["outcome"] },
    { "name": "retail_price_agent.candidate.admissions", "kind": "counter", "unit": "{candidate}", "labels": ["relevance_label", "admission_cohort", "status"] },
    { "name": "retail_price_agent.semantic_relevance.attempts", "kind": "counter", "unit": "{attempt}", "labels": ["outcome", "failure_code"] },
    { "name": "retail_price_agent.clarification.decisions", "kind": "counter", "unit": "{decision}", "labels": ["uncertainty_type", "clarification_kind"] },
    { "name": "retail_price_agent.clarification.resolutions", "kind": "counter", "unit": "{resolution}", "labels": ["clarification_kind", "outcome"] },
    { "name": "retail_price_agent.plan_review.decisions", "kind": "counter", "unit": "{decision}", "labels": ["decision", "violation_code"] },
    { "name": "retail_price_agent.goal.retention_checks", "kind": "counter", "unit": "{check}", "labels": ["field", "clarification_kind", "outcome"] },
    { "name": "retail_price_agent.answerability.decisions", "kind": "counter", "unit": "{decision}", "labels": ["mode", "uncertainty_type"] },
    { "name": "retail_price_agent.uncertainty.misattributions", "kind": "counter", "unit": "{violation}", "labels": ["source", "rendered_as"] },
    { "name": "retail_price_agent.feedback.events", "kind": "counter", "unit": "{event}", "labels": ["kind"] },
    { "name": "retail_price_agent.fence.rejected_writes", "kind": "counter", "unit": "{write}", "labels": ["operation"] },
    { "name": "retail_price_agent.claim_validation_failures", "kind": "counter", "unit": "{failure}", "labels": [] },
    { "name": "retail_price_agent.safety_blocks", "kind": "counter", "unit": "{block}", "labels": [] },
    { "name": "retail_price_agent.evidence_blocks", "kind": "counter", "unit": "{block}", "labels": [] },
    { "name": "retail_price_agent.outbox.published", "kind": "counter", "unit": "{message}", "labels": [] },
    { "name": "retail_price_agent.outbox.failures", "kind": "counter", "unit": "{failure}", "labels": [] },
    { "name": "retail_price_agent.outbox.dead_letters", "kind": "counter", "unit": "{message}", "labels": [] },
    { "name": "retail_price_agent.outbox.backlog", "kind": "observable_gauge", "unit": "{message}", "labels": ["state"] },
    { "name": "gen_ai.invoke_agent.duration", "kind": "histogram", "unit": "s", "labels": ["route"] },
    { "name": "gen_ai.invoke_agent.inference_calls", "kind": "histogram", "unit": "{call}", "labels": ["route"] },
    { "name": "gen_ai.invoke_agent.tool_calls", "kind": "histogram", "unit": "{call}", "labels": ["route", "fallback"] },
    { "name": "retail_price_agent.telemetry.link_failures", "kind": "counter", "unit": "{failure}", "labels": ["operation"] },
    { "name": "retail_price_agent.telemetry.export_lifecycle", "kind": "counter", "unit": "{event}", "labels": ["action", "outcome"] },
    { "name": "retail_price_agent.trace.causality_checks", "kind": "counter", "unit": "{check}", "labels": ["outcome"] },
    { "name": "retail_price_agent.trace.causality_violations", "kind": "counter", "unit": "{violation}", "labels": ["failure_type"] }
  ],
  "forbiddenLabels": ["turn_id", "conversation_id", "tenant_id", "owner_id", "query", "content", "prompt", "offer_ref"]
}
