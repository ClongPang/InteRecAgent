{
  "schemaVersion": 1,
  "product": "InteRecAgent",
  "positioning": "A durable, evidence-grounded, multi-turn cross-market shopping recommendation agent powered by pi-agent.",
  "conversationBoundary": "SHOPPING_MISSION",
  "turnBoundary": "DURABLE_EXECUTION",
  "invariants": [
    { "id": "conversation_outlives_turn", "statement": "A completed turn never closes the shopping conversation by itself." },
    { "id": "pi_agent_orchestrates_turn", "statement": "Pi-agent plans every natural-language turn and may invoke only phase-allowed world operations." },
    { "id": "offer_search_is_not_default", "statement": "Talk, clarification, comparison, explanation, rejection, rerank, refilter, and undo do not call providers when current evidence is sufficient." },
    { "id": "compound_turn_is_ordered", "statement": "A single utterance may produce multiple ordered operations and every accepted operation is addressed." },
    { "id": "working_set_tracks_candidate_state", "statement": "References bind against the current working set; unresolved references never fall back to rank one." },
    { "id": "clarification_continues", "statement": "Clarification is an assistant message with pending state, not a conversation terminal." },
    { "id": "known_fields_survive_clarification", "statement": "Explicitly stated shopping-goal fields remain unchanged while another user-resolvable field is clarified and after that clarification is resolved." },
    { "id": "claims_are_source_grounded", "statement": "Product, price, FX, merchant, market, stock, and condition claims require verified evidence references." },
    { "id": "unknown_stays_unknown", "statement": "Missing stock, shipping, warranty, tax, authenticity, rating, or review facts remain unknown." },
    { "id": "state_publication_is_atomic", "statement": "Goal, dialogue state, working set, assistant message, optional decision, turn status, and events publish atomically." },
    { "id": "stale_attempt_cannot_publish", "statement": "A stale revision, attempt, fence, or lease cannot publish conversation state." },
    { "id": "thread_and_workspace_persist", "statement": "Messages, conditions, candidates, focus, comparison, and active progress survive refresh and worker restart." },
    { "id": "single_active_implementation", "statement": "The product has one TypeScript/pi-agent implementation without legacy compatibility, dual write, or old-engine fallback." }
  ],
  "requiredRoutes": ["talk", "clarify", "refilter", "sort", "search"],
  "requiredCapabilities": [
    "clarification_resume",
    "compound_operations",
    "referent_binding",
    "compare_existing",
    "reject_candidate",
    "express_stance",
    "modify_goal",
    "correct_target",
    "undo",
    "focus_question",
    "explain_with_unknown",
    "interrupt_and_resume",
    "provider_partial_failure",
    "refresh_and_restart"
  ],
  "trajectories": [
    {
      "id": "clarify_then_research",
      "title": "A vague need is clarified once and resumes the same mission",
      "capabilities": ["clarification_resume"],
      "turns": [
        {
          "user": "想买个通勤用的降噪耳机。",
          "expected": {
            "route": "clarify",
            "operations": ["set_target", "set_use_case", "request_clarification:budget"],
            "providerCalls": 0,
            "outcome": "CLARIFICATION",
            "assertions": ["conversation remains OPEN", "one high-impact question is asked"]
          }
        },
        {
          "user": "2500 元，看看美国和新加坡。",
          "expected": {
            "route": "search",
            "operations": ["answer_pending_clarification", "set_budget", "set_retrieval_scope", "search_offers"],
            "providerCalls": 2,
            "outcome": "RECOMMENDATION",
            "assertions": ["same conversation", "pending clarification cleared", "assistant message and working set committed atomically"]
          }
        }
      ]
    },
    {
      "id": "compare_without_research",
      "title": "Existing candidates are compared without another provider call",
      "capabilities": ["compare_existing", "referent_binding"],
      "turns": [
        {
          "user": "帮我找 Sony WH-1000XM5，美国和新加坡都看看。",
          "expected": {
            "route": "search",
            "operations": ["set_target", "set_retrieval_scope", "search_offers"],
            "providerCalls": 2,
            "outcome": "RECOMMENDATION",
            "assertions": ["working set has source-grounded offers"]
          }
        },
        {
          "user": "第二个和第一个差在哪？",
          "expected": {
            "route": "talk",
            "operations": ["bind_rank:2", "bind_rank:1", "set_comparison", "answer_from_evidence"],
            "providerCalls": 0,
            "outcome": "CHAT",
            "assertions": ["both references are from current working set", "only evidenced differences are stated"]
          }
        }
      ]
    },
    {
      "id": "compound_reject_stance_and_ask",
      "title": "A compound utterance rejects, records stance, and asks about another item",
      "capabilities": ["compound_operations", "reject_candidate", "express_stance", "referent_binding"],
      "turns": [
        {
          "user": "比较三款 2500 元内的降噪耳机。",
          "expected": {
            "route": "search",
            "operations": ["set_target", "set_budget", "search_offers"],
            "providerCalls": 2,
            "outcome": "RECOMMENDATION",
            "assertions": ["three or fewer offers are displayed"]
          }
        },
        {
          "user": "不要第二个，还是有点贵，第三个呢？",
          "expected": {
            "route": "refilter",
            "operations": ["reject_rank:2", "set_price_stance:cheaper", "bind_rank:3", "answer_from_evidence"],
            "providerCalls": 0,
            "outcome": "CHAT",
            "assertions": ["all ordered operations are addressed", "rejected item is absent from display", "third item is not rebound after rerank"]
          }
        }
      ]
    },
    {
      "id": "local_market_refilter",
      "title": "A market restriction reuses the current pool when evidence is sufficient",
      "capabilities": ["modify_goal"],
      "turns": [
        {
          "user": "比较 XM5 在美国和新加坡的报价。",
          "expected": {
            "route": "search",
            "operations": ["set_target", "set_retrieval_scope", "search_offers"],
            "providerCalls": 2,
            "outcome": "RECOMMENDATION",
            "assertions": ["both markets were searchResult"]
          }
        },
        {
          "user": "只看美国。",
          "expected": {
            "route": "refilter",
            "operations": ["set_retrieval_scope:US", "refilter_working_set"],
            "providerCalls": 0,
            "outcome": "RECOMMENDATION",
            "assertions": ["display contains only US retrieval evidence", "pool remains available for undo"]
          }
        }
      ]
    },
    {
      "id": "target_correction_requires_research",
      "title": "A positive target correction replaces the model and starts new research",
      "capabilities": ["correct_target"],
      "turns": [
        {
          "user": "看看 Sony WH-1000XM5。",
          "expected": {
            "route": "search",
            "operations": ["set_target:WH-1000XM5", "search_offers"],
            "providerCalls": 2,
            "outcome": "RECOMMENDATION",
            "assertions": ["goal target is WH-1000XM5"]
          }
        },
        {
          "user": "不是 XM5，是 XM4。",
          "expected": {
            "route": "search",
            "operations": ["correct_target:WH-1000XM4", "invalidate_incompatible_working_set", "search_offers"],
            "providerCalls": 2,
            "outcome": "RECOMMENDATION",
            "assertions": ["XM5 is not converted into an exclusion", "XM5 offers do not enter the XM4 comparison set"]
          }
        }
      ]
    },
    {
      "id": "undo_exact_revision",
      "title": "Undo restores the exact previous goal and working-set projection",
      "capabilities": ["undo", "modify_goal"],
      "turns": [
        {
          "user": "预算 2500，比较美国和新加坡的 XM5。",
          "expected": {
            "route": "search",
            "operations": ["set_target", "set_budget:2500", "set_retrieval_scope", "search_offers"],
            "providerCalls": 2,
            "outcome": "RECOMMENDATION",
            "assertions": ["revision A committed"]
          }
        },
        {
          "user": "预算改成 3000，只看新加坡。",
          "expected": {
            "route": "refilter",
            "operations": ["set_budget:3000", "set_retrieval_scope:SG", "refilter_working_set"],
            "providerCalls": 0,
            "outcome": "RECOMMENDATION",
            "assertions": ["revision B committed"]
          }
        },
        {
          "user": "撤销刚才的修改。",
          "expected": {
            "route": "refilter",
            "operations": ["undo_revision:B"],
            "providerCalls": 0,
            "outcome": "CHAT",
            "assertions": ["goal and working-set projection equal revision A", "undo is durably recorded"]
          }
        }
      ]
    },
    {
      "id": "focused_item_unknown_stock",
      "title": "A focused item question binds correctly and preserves unknown stock",
      "capabilities": ["focus_question", "referent_binding"],
      "turns": [
        {
          "user": "给我几款 2500 元内的 XM5 报价。",
          "expected": {
            "route": "search",
            "operations": ["set_target", "set_budget", "search_offers"],
            "providerCalls": 2,
            "outcome": "RECOMMENDATION",
            "assertions": ["display offers have stable refs"]
          }
        },
        {
          "user": "这款有货吗？",
          "uiContext": { "focus": "display:2" },
          "expected": {
            "route": "talk",
            "operations": ["bind_focus", "answer_from_evidence:stock"],
            "providerCalls": 0,
            "outcome": "CHAT",
            "assertions": ["focused offer is used", "UNKNOWN is not rendered as in stock"]
          }
        }
      ]
    },
    {
      "id": "explain_and_warranty_unknown",
      "title": "An explanation uses evidence while unsupported warranty stays unknown",
      "capabilities": ["explain_with_unknown"],
      "turns": [
        {
          "user": "预算 2500，推荐一款 XM5。",
          "expected": {
            "route": "search",
            "operations": ["set_target", "set_budget", "search_offers"],
            "providerCalls": 2,
            "outcome": "RECOMMENDATION",
            "assertions": ["recommendation claims are grounded"]
          }
        },
        {
          "user": "为什么选它？保修怎么样？",
          "expected": {
            "route": "talk",
            "operations": ["explain_recommendation", "answer_from_evidence:warranty"],
            "providerCalls": 0,
            "outcome": "CHAT",
            "assertions": ["ranking reasons cite claims", "warranty is explicitly unknown", "no unsupported search is attempted"]
          }
        }
      ]
    },
    {
      "id": "refresh_and_worker_restart",
      "title": "Conversation projection survives browser refresh and worker restart",
      "capabilities": ["refresh_and_restart"],
      "turns": [
        {
          "user": "比较三款美国和新加坡的 XM5。",
          "expected": {
            "route": "search",
            "operations": ["set_target", "set_retrieval_scope", "search_offers"],
            "providerCalls": 2,
            "outcome": "RECOMMENDATION",
            "assertions": ["thread and working set committed"]
          }
        },
        {
          "user": "刷新页面并重启 worker 后，第二个多少钱？",
          "environment": ["browser_refresh", "worker_restart"],
          "expected": {
            "route": "talk",
            "operations": ["bind_rank:2", "answer_from_evidence:price"],
            "providerCalls": 0,
            "outcome": "CHAT",
            "assertions": ["thread, goal, working set, rank and cursor are restored", "no pi-agent process memory is required"]
          }
        }
      ]
    },
    {
      "id": "interrupt_batches_unconsumed_messages",
      "title": "A correction interrupts research without dropping preceding user context",
      "capabilities": ["interrupt_and_resume", "correct_target"],
      "turns": [
        {
          "user": "帮我找 XM5，预算 2500。",
          "expected": {
            "route": "search",
            "operations": ["set_target:WH-1000XM5", "set_budget", "search_offers"],
            "providerCalls": 2,
            "outcome": "SUPERSEDED",
            "assertions": ["old turn loses publication fence"]
          }
        },
        {
          "user": "不是它，是 XM4，而且只看美国。",
          "expected": {
            "route": "search",
            "operations": ["consume_unanswered_user_batch", "correct_target:WH-1000XM4", "set_retrieval_scope:US", "search_offers"],
            "providerCalls": 1,
            "outcome": "RECOMMENDATION",
            "assertions": ["the correction retains its referential base", "the superseded attempt cannot publish goal, working set, or assistant message"]
          }
        }
      ]
    },
    {
      "id": "partial_provider_failure",
      "title": "A partial market failure preserves valid evidence with disclosure",
      "capabilities": ["provider_partial_failure"],
      "turns": [
        {
          "user": "比较美国和新加坡的 XM5。",
          "environment": ["US_PROVIDER_OK", "SG_PROVIDER_UNAVAILABLE"],
          "expected": {
            "route": "search",
            "operations": ["set_target", "set_retrieval_scope", "search_offers"],
            "providerCalls": 2,
            "outcome": "RECOMMENDATION",
            "assertions": ["US source-grounded offers may be shown", "SG failure is disclosed", "provider unavailable is not reported as NO_MATCH"]
          }
        },
        {
          "user": "那新加坡是没有卖吗？",
          "expected": {
            "route": "talk",
            "operations": ["answer_from_evidence:research_status"],
            "providerCalls": 0,
            "outcome": "CHAT",
            "assertions": ["the assistant says retrieval was unavailable", "absence of evidence is not evidence of absence"]
          }
        }
      ]
    },
    {
      "id": "compound_goal_change",
      "title": "Budget, market, and rejection changes are all applied in order",
      "capabilities": ["compound_operations", "modify_goal", "reject_candidate"],
      "turns": [
        {
          "user": "比较美国和新加坡的 XM5，预算 2500。",
          "expected": {
            "route": "search",
            "operations": ["set_target", "set_budget:2500", "set_retrieval_scope", "search_offers"],
            "providerCalls": 2,
            "outcome": "RECOMMENDATION",
            "assertions": ["working set committed"]
          }
        },
        {
          "user": "预算加到 3000，只看新加坡，而且不要第二个。",
          "expected": {
            "route": "refilter",
            "operations": ["set_budget:3000", "set_retrieval_scope:SG", "reject_rank:2", "refilter_working_set"],
            "providerCalls": 0,
            "outcome": "RECOMMENDATION",
            "assertions": ["all operations are addressed", "source ranks bind before mutation", "no unnecessary provider call"]
          }
        }
      ]
    },
    {
      "id": "price_stance_reranks_locally",
      "title": "A price stance reranks the existing world without filtering or research",
      "capabilities": ["express_stance"],
      "turns": [
        {
          "user": "找几款 3000 元内的降噪耳机。",
          "expected": {
            "route": "search",
            "operations": ["set_target", "set_budget:3000", "search_offers"],
            "providerCalls": 2,
            "outcome": "RECOMMENDATION",
            "assertions": ["working set committed"]
          }
        },
        {
          "user": "还是有点贵，便宜一点。",
          "expected": {
            "route": "sort",
            "operations": ["set_price_stance:cheaper", "rerank_working_set"],
            "providerCalls": 0,
            "outcome": "RECOMMENDATION",
            "assertions": ["pool membership is unchanged", "display order may change", "no provider call"]
          }
        }
      ]
    }
  ]
}
