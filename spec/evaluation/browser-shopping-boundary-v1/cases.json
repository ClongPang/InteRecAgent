{
  "schemaVersion": 2,
  "suiteId": "shopping-boundary-traceability-v2",
  "purpose": "购物边界验收的可执行追踪表。示例只定义业务风险，不生成生产关键词分支；每条风险必须映射到真实模型评测或确定性测试。",
  "cases": [
    {
      "id": "missing-market-structured-clarification",
      "dimension": "USER_RESOLVABLE_MISSING_INFORMATION",
      "messages": ["想买头戴式耳机，预算 3000 元以内。"],
      "expected": ["PURCHASE_MARKET_CLARIFICATION", "KNOWN_TARGET_AND_BUDGET_PERSISTED", "NO_SEARCH_BEFORE_ANSWER", "CONCRETE_OPTIONS_AND_RATIONALE"],
      "executionGates": [{ "kind": "DEVELOPMENT_EVALUATION", "taskId": "gbv1-clarify_resume-01" }]
    },
    {
      "id": "natural-language-clarification-answer",
      "dimension": "FREE_TEXT_CLARIFICATION_CONTINUATION",
      "messages": ["想买头戴式耳机，预算 3000 元以内。", "美国和新加坡都看看，接着帮我找。"],
      "expected": ["MARKETS_PERSISTED", "BUDGET_PERSISTED_ACROSS_CLARIFICATION", "PENDING_CLARIFICATION_CLEARED", "SEARCH_CONTINUED"],
      "executionGates": [{ "kind": "DEVELOPMENT_EVALUATION", "taskId": "gbv1-clarify_resume-01" }]
    },
    {
      "id": "skip-market-with-explicit-assumption",
      "dimension": "AUTHORIZED_ASSUMPTION",
      "messages": ["想买一台智能手机，预算 5000 元。", "暂不限定购买市场。"],
      "expected": ["PENDING_CLARIFICATION_CLEARED", "BOUNDED_DEFAULT_MARKETS", "ASSUMPTION_DISCLOSED"],
      "executionGates": [{ "kind": "VITEST", "file": "packages/agent/test/conversation-turn-executor.test.ts", "testName": "turns a validated market skip into search-then-refine without repeating the question" }]
    },
    {
      "id": "fully-specified-open-category",
      "dimension": "COMPOSITE_INITIAL_PLAN",
      "messages": ["想买前置式洗衣机，在美国市场找，预算 7000 元以内，10 公斤是必须条件，偏好节能和低噪。"],
      "expected": ["NO_UNNECESSARY_CLARIFICATION", "ALL_EXPLICIT_REQUIREMENTS_PRESERVED", "SEARCH_OR_EVIDENCE_SAFE_DEGRADATION"],
      "executionGates": [{ "kind": "VITEST", "file": "packages/runtime/test/open-category-acceptance.test.ts", "testName": "searches washing machines without a budget or category validation policy and returns source-grounded results" }]
    },
    {
      "id": "accessory-is-the-query-target",
      "dimension": "QUERY_RELATIVE_PRODUCT_ROLE",
      "messages": ["想买手机壳，在美国市场找，预算 300 元以内。"],
      "expected": ["ACCESSORY_TARGET_RETAINED", "TARGET_ITEM_CAN_BE_EXACT", "NO_GLOBAL_COMPLEMENT_REJECTION"],
      "executionGates": [{ "kind": "VITEST", "file": "packages/domain/test/query-product-relevance.test.ts", "testName": "treats item role relative to the requested target instead of globally rejecting accessories" }]
    },
    {
      "id": "goal-change-without-refresh",
      "dimension": "USER_SEARCH_AUTHORIZATION",
      "precondition": "已有非空 WorkingSet 的对话",
      "messages": ["预算改成 2000 元，但先不要重新搜索。"],
      "expected": ["BUDGET_UPDATED", "ZERO_NEW_PRODUCT_PROVIDER_CALLS", "NO_SILENT_SEARCH"],
      "executionGates": [{ "kind": "VITEST", "file": "packages/agent/test/turn-agent.test.ts", "testName": "exposes provider-boundary context and preserves tool-call causality across generations" }]
    },
    {
      "id": "focused-candidate-unknown-warranty",
      "dimension": "MISSING_EVIDENCE_NOT_USER_AMBIGUITY",
      "precondition": "从 WorkingSet 打开一个候选",
      "messages": ["这个的保修期多久？"],
      "expected": ["FOCUS_REFERENT_USED", "NO_REFERENT_CLARIFICATION", "UNKNOWN_WARRANTY_DISCLOSED"],
      "executionGates": [{ "kind": "VITEST", "file": "packages/agent/test/offline-trajectories.test.ts", "testName": "explains only from current evidence and leaves unsupported warranty to the reply layer" }]
    },
    {
      "id": "ambiguous-product-word",
      "dimension": "INTENT_AMBIGUITY",
      "messages": ["我想买苹果，预算 5000 元。"],
      "expected": ["TARGET_MEANING_NOT_INVENTED", "USER_RESOLVABLE_CLARIFICATION_OR_SAFE_NON_SEARCH", "NO_PROVIDER_CALL_BEFORE_RESOLUTION"],
      "executionGates": [
        { "kind": "VITEST", "file": "packages/domain/test/clarification-decision-policy.test.ts", "testName": "approves only a correctly attributed user-resolvable information gap" },
        { "kind": "VITEST", "file": "packages/agent/test/conversation-turn-executor.test.ts", "testName": "does not let contextual grounding turn an unresolved target answer into a product goal" }
      ]
    }
  ]
}
