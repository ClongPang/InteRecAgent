# ── 运行环境 ─────────────────────────────────────────────
# development | test | production
INTEREC_ENV=development
# fixture：无外网无 Key 可跑完整闭环；live：真实 BuyWhere/Frankfurter
INTEREC_DATA_SOURCE=fixture
# PostgreSQL（骨架验收默认本机 Compose；Alembic 迁移用 asyncpg 驱动）
INTEREC_DATABASE_URL=postgresql+asyncpg://interec:interec@localhost:5432/interec
# BuyWhere API Key（Live Mode 才需要，示例值不真实）
INTEREC_BUYWHERE_API_KEY=
# unconfigured：确定性解析/模板解释，无需模型 Key
# openai_compat / deepseek：官方 OpenAI 兼容 Chat Completions（默认 DeepSeek-V4-Flash）
INTEREC_LLM_PROVIDER=unconfigured
INTEREC_LLM_API_KEY=
INTEREC_LLM_BASE_URL=https://api.deepseek.com
INTEREC_LLM_MODEL=deepseek-v4-flash
INTEREC_LOG_LEVEL=INFO

# ── 前端（Vite 构建期变量）────────────────────────────────
# fixture：前端内置 mock 实现；api：走 MissionApi 后端
VITE_DATA_SOURCE=api
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_DEMO_AUTH=false
