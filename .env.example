# ── 前端（留空时开发服务器通过 /api 代理）─────────────────
VITE_API_BASE_URL=
# Local development only. Production auth must inject a short-lived signed token at runtime.
VITE_AUTH_TOKEN=

# ── pi-agent runtime ──────────────────────────────────────
INTEREC_DATABASE_URL=postgresql://interec:interec@127.0.0.1:5432/interec
# 生产环境应使用具备受控 worker 权限（通常 BYPASSRLS）的独立角色；本地留空则复用上面的连接。
INTEREC_WORKER_DATABASE_URL=
INTEREC_API_HOST=127.0.0.1
INTEREC_API_PORT=8081
INTEREC_AUTH_HMAC_SECRET=replace-with-at-least-32-random-bytes
INTEREC_AUTH_ISSUER=interec-local
INTEREC_AUTH_AUDIENCE=interec-web
# 本地开发可显式开启；仅允许非 production 且 API 监听 loopback 地址。
INTEREC_ENABLE_DEV_AUTH=false
INTEREC_PROVIDER_BUYWHERE_API_KEY=
INTEREC_PROVIDER_BUYWHERE_TIMEOUT_MS=10000
INTEREC_MODEL_PROVIDER=deepseek
INTEREC_MODEL_ID=deepseek-v4-flash
INTEREC_MODEL_API_KEY=
# 仅用于人工授权的真实 BuyWhere 多用例验收；常规服务不要设置。
INTEREC_QUOTE_LIVE_ACCEPTANCE_CONFIRM=

# Langfuse v5（同时配置 public/secret key 才启用；Cloud EU 或自托管地址均可）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
# 默认采集经脱敏的 query/prompt/output/tool 参数。设为 false 则只留结构和决策扫描行。
INTEREC_LANGFUSE_CAPTURE_CONTENT=true
INTEREC_TELEMETRY_PSEUDONYM_KEY=
# External writes are deny-by-default and require these exact one-shot confirmations.
INTEREC_LANGFUSE_PROMPT_SYNC_CONFIRM=
INTEREC_LANGFUSE_EXPERIMENT_PUBLISH_CONFIRM=
# 真实 Langfuse 回读：npm run observability:smoke。必须写成 authorized-langfuse-readback。
INTEREC_LANGFUSE_SMOKE_CONFIRM=

# 可选 OTLP 指标端点，留空即可。
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
