{
  "name": "interec-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b packages/domain packages/agent packages/runtime packages/api",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "node scripts/run_postgres_integration.mjs",
    "observability:smoke": "tsx --env-file-if-exists=.env packages/runtime/src/langfuse-smoke.ts",
    "observability:dataset:sync": "tsx --env-file-if-exists=.env scripts/sync_langfuse_eval_dataset.ts",
    "observability:prompt:sync": "tsx --env-file-if-exists=.env scripts/sync_langfuse_prompt.ts",
    "observability:scores:publish": "tsx --env-file-if-exists=.env scripts/publish_langfuse_development_evaluation_scores.ts",
    "observability:experiment:publish": "tsx --env-file-if-exists=.env scripts/publish_langfuse_development_evaluation.ts",
    "observability:experiment:check": "tsx --env-file-if-exists=.env scripts/check_langfuse_development_evaluation.ts",
    "observability:ingestion:check": "tsx --env-file-if-exists=.env scripts/check_langfuse_ingestion.ts",
    "observability:publication:check": "tsc -p tsconfig.langfuse-scripts.json",
    "live:turn:once": "tsx --env-file-if-exists=.env packages/runtime/src/conversation-live-turn-once.ts",
    "acceptance:gold": "tsx packages/agent/src/gold-evaluator-main.ts",
    "acceptance:tasks": "tsx packages/agent/src/task-evaluator-main.ts",
    "acceptance:evaluation:plan": "tsx packages/agent/src/evaluation-authoring-plan-main.ts",
    "acceptance:evaluation:cases": "tsx packages/agent/src/development-evaluation-cases-main.ts",
    "acceptance:evaluation:capture": "tsx --env-file-if-exists=.env scripts/capture_development_evaluation_fixture.ts",
    "acceptance:evaluation:run": "tsx --env-file-if-exists=.env scripts/run_development_evaluation.ts",
    "acceptance:evaluation:score": "tsx scripts/score_development_evaluation.ts",
    "acceptance:boundary:check": "node scripts/check_shopping_boundary_traceability.mjs",
    "acceptance:evaluation:release": "npm run acceptance:evaluation:dev && npm run acceptance:boundary:check && npm run acceptance:evaluation:run && npm run acceptance:evaluation:score",
    "acceptance:context-ablation": "tsx --env-file-if-exists=.env scripts/run_context_ablation_evaluation.ts",
    "acceptance:context-ablation:score": "tsx scripts/score_context_ablation_evaluation.ts",
    "acceptance:regression": "tsx packages/agent/src/evaluation-regression-main.ts",
    "acceptance:protocol": "tsx packages/agent/src/protocol-negative-tests-main.ts",
    "acceptance:fault:manifest": "tsx packages/runtime/src/fault-manifest-main.ts",
    "acceptance:fault": "tsx packages/runtime/src/fault-acceptance-main.ts",
    "acceptance:evaluation:dev": "npm run acceptance:evaluation:plan && npm run acceptance:evaluation:cases && npm run acceptance:boundary:check && npm run acceptance:tasks && npm run acceptance:protocol && npm run acceptance:fault:manifest",
    "acceptance:shadow": "tsx packages/agent/src/shadow-evaluator-main.ts",
    "acceptance:runtime-smoke": "node --env-file-if-exists=.env scripts/runtime_smoke.mjs",
    "acceptance:live:inspect": "node --env-file-if-exists=.env scripts/inspect_live_acceptance.mjs",
    "acceptance:live:probe": "tsx --env-file-if-exists=.env scripts/probe_live_dependencies.ts",
    "acceptance:live:compatibility": "tsx --env-file-if-exists=.env scripts/check_live_dependency_compatibility.ts",
    "acceptance:live:cases": "tsx --env-file-if-exists=.env scripts/run_live_exact_cases.ts",
    "acceptance:live:clarification": "tsx --env-file-if-exists=.env scripts/run_live_clarification_case.ts",
    "acceptance:live:requalify": "tsx --env-file-if-exists=.env scripts/requalify_live_capture.ts",
    "acceptance:operations": "tsx packages/runtime/src/operations-acceptance-main.ts",
    "db:migrate": "tsx --env-file-if-exists=.env packages/runtime/src/migrate.ts",
    "dev:api": "tsx --env-file-if-exists=.env packages/api/src/conversation-api-main.ts",
    "dev:worker": "tsx --env-file-if-exists=.env packages/runtime/src/conversation-worker-main.ts",
    "product:check": "node scripts/check_product_contract.mjs",
    "clarification:goal:check": "node scripts/check_clarification_goal.mjs",
    "architecture:policy-route:check": "node scripts/check_policy_constrained_agent_goal.mjs",
    "architecture:p1:check": "node scripts/check_policy_constrained_agent_p1.mjs",
    "architecture:p2:check": "node scripts/check_policy_constrained_agent_p2.mjs",
    "architecture:p3:check": "node scripts/check_policy_constrained_agent_p3.mjs",
    "architecture:p4:check": "node scripts/check_policy_constrained_agent_p4.mjs",
    "architecture:p5:check": "node scripts/check_policy_constrained_agent_p5.mjs",
    "architecture:check": "node scripts/check_active_architecture.mjs",
    "workflow:check": "node scripts/check_workflow.mjs",
    "observability:check": "node scripts/check_observability_contract.mjs",
    "acceptance": "npm run product:check && npm run clarification:goal:check && npm run acceptance:boundary:check && npm run architecture:policy-route:check && npm run architecture:p1:check && npm run architecture:p2:check && npm run architecture:p3:check && npm run architecture:p4:check && npm run architecture:p5:check && npm run architecture:check && npm run workflow:check && npm run observability:check && npm run observability:publication:check && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "yaml": "2.9.0"
  }
}
