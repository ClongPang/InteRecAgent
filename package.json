{
  "name": "retail-price-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "clean:build": "node scripts/clean_build_outputs.mjs",
    "build": "npm run clean:build && npm run build --workspaces --if-present",
    "docs:check": "node scripts/check_docs_drift.mjs",
    "observability:check": "node scripts/check_agent_trace_observability.mjs",
    "observability:smoke": "tsx --env-file-if-exists=.env scripts/observability_smoke.ts",
    "quote:contract:check": "node scripts/check_quote_lead_contract.mjs",
    "quote:drift:check": "node scripts/check_quote_lead_drift.mjs",
    "identity:contract:check": "node scripts/check_identity_grounded_quote_contract.mjs",
    "identity:drift:check": "node scripts/check_identity_grounded_quote_drift.mjs",
    "identity:trajectory:test": "tsx scripts/run_identity_grounded_trajectories.ts",
    "identity:agent:eval": "vitest run packages/agent/test/identity-grounded-agent-eval.test.ts",
    "identity:shadow:replay": "tsx scripts/run_identity_resolution_shadow_replay.ts",
    "identity:mutation:test": "tsx scripts/run_identity_mutations.ts",
    "quote:live:probe": "tsx --env-file-if-exists=.env scripts/probe_quote_provider.ts",
    "quote:live:acceptance": "tsx --env-file-if-exists=.env scripts/run_quote_live_acceptance.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b packages/domain packages/agent packages/runtime packages/api && tsc -p tsconfig.active-scripts.json",
    "test": "vitest run",
    "test:coverage": "node scripts/run_quote_coverage.mjs",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "node scripts/run_postgres_integration.mjs",
    "db:migrate": "tsx --env-file-if-exists=.env packages/runtime/src/migrate.ts",
    "dev:api": "tsx --env-file-if-exists=.env packages/api/src/conversation-api-main.ts",
    "dev:worker": "tsx --env-file-if-exists=.env packages/runtime/src/conversation-worker-main.ts",
    "architecture:active:check": "node scripts/check_quote_active_architecture.mjs",
    "architecture:maintainability:check": "node scripts/check_maintainability_boundaries.mjs",
    "acceptance": "npm run quote:contract:check && npm run quote:drift:check && npm run identity:contract:check && npm run identity:trajectory:test && npm run identity:agent:eval && npm run identity:shadow:replay && npm run identity:mutation:test && npm run identity:drift:check && npm run docs:check && npm run observability:check && npm run lint && npm run architecture:maintainability:check && npm run typecheck && npm run build && npm run test:unit && npm run test:coverage && npm run test:integration && npm run test:e2e && npm run architecture:active:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.9.1",
    "esbuild": "0.25.12",
    "globals": "17.11.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.9",
    "yaml": "2.9.0"
  }
}
