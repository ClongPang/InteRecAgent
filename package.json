{
  "name": "interec-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b packages/domain packages/agent packages/runtime packages/api",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --maxWorkers=1 --no-file-parallelism packages/runtime/test/postgres-conversation-repository.integration.test.ts packages/api/test/postgres-api.integration.test.ts",
    "observability:smoke": "tsx --env-file-if-exists=.env packages/runtime/src/langfuse-smoke.ts",
    "live:turn:once": "tsx --env-file-if-exists=.env packages/runtime/src/conversation-live-turn-once.ts",
    "acceptance:gold": "tsx packages/agent/src/gold-evaluator-main.ts",
    "acceptance:shadow": "tsx packages/agent/src/shadow-evaluator-main.ts",
    "acceptance:runtime-smoke": "node --env-file-if-exists=.env scripts/runtime_smoke.mjs",
    "acceptance:live:inspect": "node --env-file-if-exists=.env scripts/inspect_live_acceptance.mjs",
    "acceptance:live:probe": "tsx --env-file-if-exists=.env scripts/probe_live_dependencies.ts",
    "acceptance:live:cases": "tsx --env-file-if-exists=.env scripts/run_live_exact_cases.ts",
    "acceptance:live:requalify": "tsx --env-file-if-exists=.env scripts/requalify_live_capture.ts",
    "acceptance:operations": "tsx packages/runtime/src/operations-acceptance-main.ts",
    "db:migrate": "tsx --env-file-if-exists=.env packages/runtime/src/migrate.ts",
    "dev:api": "tsx --env-file-if-exists=.env packages/api/src/conversation-api-main.ts",
    "dev:worker": "tsx --env-file-if-exists=.env packages/runtime/src/conversation-worker-main.ts",
    "product:check": "node scripts/check_product_contract.mjs",
    "architecture:check": "node scripts/check_active_architecture.mjs",
    "workflow:check": "node scripts/check_workflow.mjs",
    "observability:check": "node scripts/check_observability_contract.mjs",
    "acceptance": "npm run product:check && npm run architecture:check && npm run workflow:check && npm run observability:check && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "yaml": "2.9.0"
  }
}
