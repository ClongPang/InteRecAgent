{
  "name": "interec-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b packages/domain packages/agent packages/runtime packages/api",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "node scripts/run_postgres_integration.mjs",
    "observability:smoke": "tsx --env-file-if-exists=.env packages/runtime/src/langfuse-smoke.ts",
    "observability:dataset:sync": "tsx --env-file-if-exists=.env scripts/sync_langfuse_eval_dataset.ts",
    "observability:prompt:sync": "tsx --env-file-if-exists=.env scripts/sync_langfuse_prompt.ts",
    "observability:scores:publish": "tsx --env-file-if-exists=.env scripts/publish_langfuse_qualification_scores.ts",
    "observability:experiment:publish": "tsx --env-file-if-exists=.env scripts/publish_langfuse_qualification_experiment.ts",
    "observability:experiment:check": "tsx --env-file-if-exists=.env scripts/check_langfuse_qualification_experiment.ts",
    "observability:ingestion:check": "tsx --env-file-if-exists=.env scripts/check_langfuse_ingestion.ts",
    "live:turn:once": "tsx --env-file-if-exists=.env packages/runtime/src/conversation-live-turn-once.ts",
    "acceptance:gold": "tsx packages/agent/src/gold-evaluator-main.ts",
    "acceptance:tasks": "tsx packages/agent/src/task-evaluator-main.ts",
    "acceptance:gold:blueprint": "tsx packages/agent/src/gold-blueprint-main.ts",
    "acceptance:qualification:cases": "tsx packages/agent/src/internal-qualification-cases-main.ts",
    "acceptance:qualification:capture": "tsx --env-file-if-exists=.env scripts/capture_internal_qualification_fixture.ts",
    "acceptance:qualification:run": "tsx --env-file-if-exists=.env scripts/run_internal_qualification.ts",
    "acceptance:qualification:score": "tsx scripts/score_internal_qualification.ts",
    "acceptance:drift": "tsx packages/agent/src/evaluation-drift-main.ts",
    "acceptance:protocol": "tsx packages/agent/src/protocol-adversarial-main.ts",
    "acceptance:fault:manifest": "tsx packages/runtime/src/fault-manifest-main.ts",
    "acceptance:fault": "tsx packages/runtime/src/fault-acceptance-main.ts",
    "acceptance:evaluation:dev": "npm run acceptance:gold:blueprint && npm run acceptance:qualification:cases && npm run acceptance:tasks && npm run acceptance:protocol && npm run acceptance:fault:manifest",
    "acceptance:shadow": "tsx packages/agent/src/shadow-evaluator-main.ts",
    "acceptance:runtime-smoke": "node --env-file-if-exists=.env scripts/runtime_smoke.mjs",
    "acceptance:live:inspect": "node --env-file-if-exists=.env scripts/inspect_live_acceptance.mjs",
    "acceptance:live:probe": "tsx --env-file-if-exists=.env scripts/probe_live_dependencies.ts",
    "acceptance:live:drift": "tsx --env-file-if-exists=.env scripts/check_live_service_drift.ts",
    "acceptance:live:cases": "tsx --env-file-if-exists=.env scripts/run_live_exact_cases.ts",
    "acceptance:live:requalify": "tsx --env-file-if-exists=.env scripts/requalify_live_capture.ts",
    "acceptance:operations": "tsx packages/runtime/src/operations-acceptance-main.ts",
    "db:migrate": "tsx --env-file-if-exists=.env packages/runtime/src/migrate.ts",
    "dev:api": "tsx --env-file-if-exists=.env packages/api/src/conversation-api-main.ts",
    "dev:worker": "tsx --env-file-if-exists=.env packages/runtime/src/conversation-worker-main.ts",
    "product:check": "node scripts/check_product_contract.mjs",
    "architecture:check": "node scripts/check_active_architecture.mjs",
    "workflow:check": "node scripts/check_workflow.mjs",
    "observability:check": "node scripts/check_observability_contract.mjs",
    "acceptance": "npm run product:check && npm run architecture:check && npm run workflow:check && npm run observability:check && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "yaml": "2.9.0"
  }
}
