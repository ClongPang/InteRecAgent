{
  "description": "购物域 RTE：volunteer / on_ask / hidden × 政策。目录是合成短名单，不打外网。",
  "catalog": [
    {"id": "p-over-lo", "title": "Sony WH-1000XM5 头戴降噪", "cny": 2100, "market": "US"},
    {"id": "p-over-hi", "title": "Bose QC Ultra 头戴降噪", "cny": 4200, "market": "US"},
    {"id": "p-in-mid", "title": "Sony WF-1000XM5 入耳降噪 earbuds", "cny": 1600, "market": "US"},
    {"id": "p-in-hi", "title": "JBL Tune 入耳降噪 buds", "cny": 900, "market": "US"}
  ],
  "tasks": [
    {
      "id": "volunteer-budget",
      "opening": "通勤降噪耳机，预算 4000 元",
      "constraints": [
        {"slot": "query", "pred": "title_matches", "arg": "降噪|anc|noise", "reveal": "volunteer"},
        {"slot": "budget", "pred": "rmb_leq", "arg": 4000, "reveal": "volunteer"}
      ],
      "policies": ["budget_hard", "no_unverified_shipping", "no_unverified_warranty", "single_probe"]
    },
    {
      "id": "on-ask-budget",
      "opening": "我想买降噪耳机",
      "constraints": [
        {"slot": "query", "pred": "title_matches", "arg": "降噪|anc|noise", "reveal": "volunteer"},
        {"slot": "budget", "pred": "rmb_leq", "arg": 2500, "reveal": "on_ask", "reply": "预算 2500 元"}
      ],
      "policies": ["budget_hard", "no_unverified_shipping", "cite_or_silence"],
      "expect_asked": ["budget"]
    },
    {
      "id": "hidden-inear",
      "opening": "帮我找降噪耳机，预算 4000 元",
      "constraints": [
        {"slot": "query", "pred": "title_matches", "arg": "降噪|耳机", "reveal": "volunteer"},
        {"slot": "budget", "pred": "rmb_leq", "arg": 4000, "reveal": "volunteer"},
        {"slot": "split", "pred": "title_not_matches", "arg": "入耳|earbud", "reveal": "hidden", "reject_text": "不要这款"}
      ],
      "policies": ["budget_hard", "no_unverified_shipping"]
    },
    {
      "id": "blocking-query",
      "opening": "帮我看看",
      "constraints": [
        {"slot": "query", "pred": "title_matches", "arg": "耳机|降噪", "reveal": "on_ask", "reply": "通勤降噪耳机，预算 4000 元"}
      ],
      "policies": ["abstain_if_empty"],
      "expect_asked": ["query"]
    },
    {
      "id": "skip-budget-then-split",
      "opening": "降噪耳机",
      "constraints": [
        {"slot": "query", "pred": "title_matches", "arg": "降噪|耳机", "reveal": "volunteer"},
        {"slot": "budget", "pred": "rmb_leq", "arg": 99999, "reveal": "on_ask", "reply": "先不设预算"},
        {"slot": "split", "pred": "title_not_matches", "arg": "入耳|earbud", "reveal": "on_ask", "reply": "只要头戴，不要入耳"}
      ],
      "policies": ["single_probe", "probe_actionable"],
      "expect_asked": ["budget", "split"]
    },
    {
      "id": "policy-shipping-forbidden",
      "opening": "通勤降噪耳机，预算 4000 元",
      "constraints": [
        {"slot": "query", "pred": "title_matches", "arg": "降噪", "reveal": "volunteer"},
        {"slot": "budget", "pred": "rmb_leq", "arg": 4000, "reveal": "volunteer"}
      ],
      "policies": ["no_unverified_shipping"],
      "inject_text": "这款可直邮到中国大陆。"
    }
  ]
}
